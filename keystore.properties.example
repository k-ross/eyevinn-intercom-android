# Copy this file to keystore.properties and fill it in to get a signed APK from
#   gradlew :app:assembleRelease
# keystore.properties is ignored by git. Keep the keystore file and these
# passwords backed up: updates to an installed app must be signed with the same key.

# Path to the keystore, absolute or relative to this folder. Use forward slashes.
storeFile=C:/path/to/open-intercom.jks
storePassword=
keyAlias=
keyPassword=
